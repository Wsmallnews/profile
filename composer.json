{
    "name": "wsmallnews/profile",
    "description": "Wsmallnews user profile module (addresses, invoices and more)",
    "keywords": [
        "Wsmallnews",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "profile",
        "address"
    ],
    "homepage": "https://github.com/wsmallnews/profile",
    "support": {
        "issues": "https://github.com/wsmallnews/profile/issues",
        "source": "https://github.com/wsmallnews/profile"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "smallnews",
            "email": "smallnews@qq.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "commerceguys/addressing": "^2.0",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.15.0",
        "wsmallnews/support": "^1.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.7|^4.0",
        "pestphp/pest-plugin-laravel": "^3.7|^4.0",
        "pestphp/pest-plugin-livewire": "^3.7|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Wsmallnews\\Profile\\": "src/",
            "Wsmallnews\\Profile\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wsmallnews\\Profile\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "test": "pest",
        "test:lint": "pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Wsmallnews\\Profile\\ProfileServiceProvider"
            ],
            "aliases": {
                "Profile": "Wsmallnews\\Profile\\Facades\\Profile"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
